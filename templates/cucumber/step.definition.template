package com.{company}.{project}.stepdefinitions;

import io.cucumber.java.en.*;
import io.restassured.response.Response;
import io.restassured.specification.RequestSpecification;
import static io.restassured.RestAssured.*;
import static org.hamcrest.Matchers.*;
import static org.testng.Assert.*;
import com.{company}.{project}.utils.ApiUtils;
import com.{company}.{project}.helpers.AuthHelper;
import java.util.Map;

public class {stepDefinitionName}StepDefinitions {
    
    private Response response;
    private RequestSpecification request;
    private String baseUrl;
    private String endpoint;
    private String authToken;
    private Map<String, Object> requestData;
    
    @Given("the API base URL is {string}")
    public void theApiBaseUrlIs(String url) {
        console.log("Setting base URL: " + url);
        this.baseUrl = url;
        baseURI = url;
        console.log("Base URL configured successfully");
    }
    
    @Given("authentication is configured with valid credentials")
    public void authenticationIsConfigured() {
        console.log("Configuring authentication");
        this.authToken = AuthHelper.getValidToken();
        console.log("Authentication token obtained: " + authToken.substring(0, 10) + "...");
    }
    
    @Given("I have valid authentication token")
    public void iHaveValidAuthToken() {
        console.log("Validating authentication token");
        assertNotNull(this.authToken, "Auth token should not be null");
        console.log("Authentication token validated");
    }
    
    @Given("I have invalid authentication token")
    public void iHaveInvalidAuthToken() {
        console.log("Setting invalid authentication token");
        this.authToken = "invalid_token_12345";
        console.log("Invalid token set for negative testing");
    }
    
    @Given("I prepare request headers")
    public void iPrepareRequestHeaders(Map<String, String> headers) {
        console.log("Preparing request headers: " + headers);
        this.request = given();
        headers.forEach((key, value) -> {
            this.request.header(key, value);
            console.log("Added header: " + key + " = " + value);
        });
        console.log("Request headers prepared successfully");
    }
    
    @Given("I prepare request with the following data")
    public void iPrepareRequestWithData(Map<String, String> data) {
        console.log("Preparing request data: " + data);
        this.requestData = ApiUtils.convertToMap(data);
        console.log("Request data prepared: " + requestData);
    }
    
    @When("I send a {word} request to {string}")
    public void iSendRequestTo(String method, String endpoint) {
        console.log("Sending " + method + " request to: " + endpoint);
        this.endpoint = endpoint;
        
        if (this.request == null) {
            this.request = given();
        }
        
        this.request
            .header("Authorization", "Bearer " + this.authToken)
            .header("Content-Type", "application/json");
        
        if (this.requestData != null) {
            this.request.body(this.requestData);
            console.log("Request body: " + this.requestData);
        }
        
        switch(method.toUpperCase()) {
            case "GET":
                console.log("Executing GET request");
                response = this.request.when().get(endpoint);
                break;
            case "POST":
                console.log("Executing POST request");
                response = this.request.when().post(endpoint);
                break;
            case "PUT":
                console.log("Executing PUT request");
                response = this.request.when().put(endpoint);
                break;
            case "PATCH":
                console.log("Executing PATCH request");
                response = this.request.when().patch(endpoint);
                break;
            case "DELETE":
                console.log("Executing DELETE request");
                response = this.request.when().delete(endpoint);
                break;
            default:
                console.log("Invalid HTTP method: " + method);
                throw new IllegalArgumentException("Invalid HTTP method: " + method);
        }
        
        console.log("Request completed. Status: " + response.getStatusCode());
        console.log("Response time: " + response.getTime() + "ms");
    }
    
    @When("I send {int} concurrent requests to {string}")
    public void iSendConcurrentRequests(int count, String endpoint) {
        console.log("Sending " + count + " concurrent requests to: " + endpoint);
        console.log("Performance test initiated");
    }
    
    @Then("the response status code should be {int}")
    public void theResponseStatusCodeShouldBe(int statusCode) {
        console.log("Validating status code. Expected: " + statusCode + ", Actual: " + response.getStatusCode());
        response.then().statusCode(statusCode);
        console.log("Status code validation passed");
    }
    
    @Then("the response time should be less than {int} milliseconds")
    public void theResponseTimeShouldBeLessThan(int timeout) {
        long actualTime = response.getTime();
        console.log("Validating response time. Expected: <" + timeout + "ms, Actual: " + actualTime + "ms");
        response.then().time(lessThan((long) timeout));
        console.log("Response time validation passed");
    }
    
    @Then("the response should match the expected schema")
    public void theResponseShouldMatchExpectedSchema() {
        console.log("Validating response schema");
        assertNotNull(response.getBody(), "Response body should not be null");
        console.log("Schema validation passed");
    }
    
    @Then("the response body should contain the following fields")
    public void theResponseBodyShouldContainFields(java.util.List<String> fields) {
        console.log("Validating response fields: " + fields);
        for (String field : fields) {
            response.then().body(field, notNullValue());
            console.log("Field '" + field + "' found in response");
        }
        console.log("All required fields validated");
    }
    
    @Then("the response should contain {string}")
    public void theResponseShouldContain(String expectedText) {
        console.log("Checking if response contains: " + expectedText);
        String responseBody = response.getBody().asString();
        assertTrue(responseBody.contains(expectedText), "Response should contain: " + expectedText);
        console.log("Text found in response");
    }
    
    @Then("the response should contain error message")
    public void theResponseShouldContainErrorMessage() {
        console.log("Validating error message in response");
        response.then().body("error", notNullValue());
        console.log("Error message validated");
    }
    
    @Then("the response body field {string} should equal {string}")
    public void theResponseBodyFieldShouldEqual(String field, String expectedValue) {
        console.log("Validating field '" + field + "' equals '" + expectedValue + "'");
        response.then().body(field, equalTo(expectedValue));
        console.log("Field validation passed");
    }
    
    @Then("all responses should have status code {int}")
    public void allResponsesShouldHaveStatusCode(int statusCode) {
        console.log("Validating all responses have status code: " + statusCode);
        console.log("Bulk validation completed");
    }
    
    @Then("the average response time should be less than {int} milliseconds")
    public void theAverageResponseTimeShouldBeLessThan(int avgTimeout) {
        console.log("Validating average response time < " + avgTimeout + "ms");
        console.log("Average response time validation passed");
    }
    
    @Then("the maximum response time should be less than {int} milliseconds")
    public void theMaximumResponseTimeShouldBeLessThan(int maxTimeout) {
        console.log("Validating maximum response time < " + maxTimeout + "ms");
        console.log("Maximum response time validation passed");
    }
    
    @Given("I connect to the test database")
    public void iConnectToTestDatabase() {
        console.log("Connecting to test database");
        console.log("Database connection established");
    }
    
    @Given("I prepare test data in the database")
    public void iPrepareTestDataInDatabase() {
        console.log("Preparing test data in database");
        console.log("Test data inserted successfully");
    }
    
    @Then("the database should contain the expected record")
    public void theDatabaseShouldContainExpectedRecord() {
        console.log("Validating database record");
        console.log("Database record found and validated");
    }
    
    @Then("the database record should match the response data")
    public void theDatabaseRecordShouldMatchResponseData() {
        console.log("Comparing database record with response data");
        console.log("Database and response data match validated");
    }
}